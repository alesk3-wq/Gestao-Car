rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(driverId) {
      return isSignedIn() && request.auth.uid == driverId;
    }

    // Conta única de manutenção/testes (semear e apagar turnos de teste).
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'alesk3@gmail.com';
    }

    // Condutores: cada um lê/edita o próprio perfil; admin gerencia todos.
    // Qualquer usuário logado pode ler a lista (nomes aparecem em turnos/histórico)
    // e criar o próprio doc no cadastro (sempre como role "driver").
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isSelf(driverId)
        && request.resource.data.role == 'driver';
      allow update: if isAdmin()
        || (isSelf(driverId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Veículos: condutor só lê; admin gerencia.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Revisões / manutenção: qualquer logado lê; só admin registra.
    match /maintenance/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Turnos: condutor cria/edita os próprios enquanto abertos.
    // Turno fechado é imutável (auditoria) — nem admin edita/deleta.
    match /trips/{tripId} {
      // Turnos fechados ficam visíveis a qualquer condutor logado (handoff de
      // KM: o próximo condutor precisa ler o turno fechado do anterior, que
      // não é o dono do documento). Turnos abertos continuam privados.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.driverId == request.auth.uid)
        || (isSignedIn() && resource.data.status == 'closed');
      // superadmin pode semear turnos de teste já fechados (fora do fluxo normal)
      allow create: if (isSignedIn()
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'open')
        || isSuperAdmin();
      allow update: if (isSignedIn()
          && resource.data.driverId == request.auth.uid
          && resource.data.status == 'open')
        || isSuperAdmin()
        // admin pode ajustar SÓ o horário de início/fim, mesmo com o turno fechado
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startTime', 'endTime']));
      // turno fechado é imutável pra todo mundo, exceto a limpeza do superadmin
      allow delete: if isSuperAdmin();
    }

    // Avarias: condutor registra e lê; só admin resolve/edita depois.
    // Leitura liberada pra logados (handoff: condutor precisa ver avarias anteriores do veículo).
    match /damages/{damageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.driverId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }
  }
}
