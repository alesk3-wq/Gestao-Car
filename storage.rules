rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fotos organizadas por vehicleId/tripId/ (avarias e recibos).
    // Só usuários logados; apenas imagens até 10MB.
    match /{vehicleId}/{tripId}/{fileName} {
      allow read: if request.auth != null;
      // Só `create`, sem `update`: o uploadPhoto() sempre gera nome único
      // (timestamp), então ninguém precisa sobrescrever — e permitir update
      // deixaria qualquer logado trocar a foto de avaria de outro turno, que é
      // justamente a evidência central do app.
      allow create: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // limpeza de fotos de teste — só a conta de manutenção
      allow delete: if request.auth != null
        && request.auth.token.email == 'alesk3@gmail.com';
    }
  }
}
